# Java and JVM artifacts
*.class
hs_err_pid*
replay_pid*

# Gradle and generated build output
/.gradle/
/bin/
/build/

# Local Star Rod data and runtime output
/local/

# Legacy Star Rod config location
/cfg/

# Eclipse: keep shared encoding, compiler, formatter, and cleanup settings
/.settings/*
!/.settings/org.eclipse.core.resources.prefs
!/.settings/org.eclipse.jdt.core.prefs
!/.settings/org.eclipse.jdt.ui.prefs

# VS Code: keep the shared workspace settings only
/.vscode/*
!/.vscode/settings.json
