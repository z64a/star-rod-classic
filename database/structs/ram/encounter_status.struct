% encounter_status
% from 800b0f10
type: ram
size: BF4
fields:
{
	  0 : flags                    : int
	  4 : firstStrikeType          : byte       % 0 = none, 1 = player, 2 = enemy
	  5 : hitType                  : byte
	  6 : hitTier                  : byte       % 0 = normal, 1 = super, 2 = ultra
	  7 : unk_07                   : byte
	  8 : battleTransitionState    : byte
	  9 : battleOutcome            : byte
	  A : battleTriggerCooldown    : byte       % set to 15 after victory, 45 after fleeing
	  B : hasMerleeCoinBonus       : ubyte      % triple coins when nonzero
	  C : damageTaken              : ubyte      % valid after battle
	  D : pad_0D                   : ubyte
	  E : coinsEarned              : short      % valid after battle
	 10 : instigatorValue          : byte
	 11 : forbidFleeing            : byte
	 12 : scriptedBattle           : byte       % started by StartBattle rather than an encounter
	 13 : dropWhackaBump           : byte
	 14 : songID                   : int
	 18 : unk_18                   : int        % unused; related to songID
	 1C : numEncounters            : byte       % number of encounters for the current map
	 1D : curAreaIndex             : byte
	 1E : curMapIndex              : ubyte
	 1F : curEntryIndex            : ubyte
	 20 : mapID                    : byte
	 21 : resetMapEncounterFlags   : byte
	 22 : pad_22                   : ubyte[2`]
	 24 : npcGroupList             : int*
	 28 : encounterList            : encounter*[24`]
	 88 : curEncounter             : encounter*
	 8C : curEnemy                 : enemy*
	 90 : fadeOutAmount            : int
	 94 : substateDelay            : int
	 98 : fadeOutAccel             : int
	 9C : battleStartCountdown     : int
	 A0 : dizzyAttack              : field_status
	 A4 : unusedAttack1            : field_status
	 A8 : unusedAttack2            : field_status
	 AC : unusedAttack3            : field_status
	 B0 : defeatFlags              : int[60`][12`]
	BF0 : recentMaps               : short[2`]
}
