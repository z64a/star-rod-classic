% player_data
type: ram
size: 428
fields:
{
	  0 : bootsLevel              : byte
	  1 : hammerLevel             : byte
	  2 : curHP                   : byte
	  3 : curMaxHP                : byte
	  4 : hardMaxHP               : byte
	  5 : curFP                   : byte
	  6 : curMaxFP                : byte
	  7 : hardMaxFP               : byte
	  8 : maxBP                   : byte
	  9 : level                   : byte
	  A : hasActionCommands       : byte
	  B : pad_00B                 : ubyte
	  C : coins                   : short
	  E : fortressKeyCount        : byte
	  F : starPieces              : ubyte
	 10 : starPoints              : byte
	 11 : unused_011              : byte
	 12 : curPartner              : byte
	 13 : pad_013                 : ubyte
	 14 : partners                : partner_data[12`]
	 74 : keyItems                : short[32`]
	 B4 : badges                  : short[128`]
	1B4 : invItems                : short[10`]
	1C8 : storedItems             : short[32`]
	208 : equippedBadges          : short[64`]
	288 : unused_288              : byte
	289 : merleeSpellType         : byte
	28A : merleeCastsLeft         : byte
	28B : pad_28B                 : ubyte
	28C : merleeTurnCount         : short
	28E : maxStarPower            : byte
	28F : pad_28F                 : ubyte
	290 : starPower               : short
	292 : starBeamLevel           : byte
	293 : pad_293                 : ubyte
	294 : actionCommandAttempts   : ushort
	296 : actionCommandSuccesses  : ushort
	298 : hitsTaken               : ushort
	29A : hitsBlocked             : ushort
	29C : playerFirstStrikes      : ushort
	29E : enemyFirstStrikes       : ushort
	2A0 : powerBounces            : ushort
	2A2 : battlesCount            : ushort
	2A4 : battlesWon              : ushort
	2A6 : fleeAttempts            : ushort
	2A8 : battlesFled             : ushort
	2AA : trainingsDone           : ushort
	2AC : walkingStepsTaken       : int
	2B0 : runningStepsTaken       : int
	2B4 : totalCoinsEarned        : uint
	2B8 : idleFrameCounter        : short      % frames with no inputs, overflows about every 36 minutes
	2BA : pad_2BA                 : ubyte[2`]
	2BC : frameCounter            : uint       % increases by 2 per frame
	2C0 : quizzesAnswered         : ushort
	2C2 : quizzesCorrect          : ushort
	2C4 : partnerUnlockedTime     : int[12`]
	2F4 : partnerUsedTime         : int[12`]
	324 : tradeEventStartTime     : int
	328 : droTreeHintTime         : int
	32C : starPiecesCollected     : ushort
	32E : jumpGamePlays           : ushort
	330 : jumpGameTotal           : uint       % all-time winnings, max = 99999
	334 : jumpGameRecord          : ushort
	336 : smashGamePlays          : ushort
	338 : smashGameTotal          : uint       % all-time winnings, max = 99999
	33C : smashGameRecord         : ushort
	33E : pad_33E                 : ubyte[2`]
	340 : reserved                : ubyte[232`] % unused save-data space following the live fields
}

