% enemy
type: ram
size: E8
fields:
{
	  0 : flags              : int
	  4 : encounterIndex     : byte
	  5 : encountered        : byte
	  6 : scriptGroup        : ubyte      % scripts launched for this NPC controller use this group
	  7 : firstStrikeActive  : byte       % contact triggers a first strike when nonzero
	  8 : npcID              : short
	  A : spawnPos           : short[3`]
	 10 : attackOriginPos    : short[3`]  % position captured when firstStrikeActive is set
	 16 : pad_16             : ubyte[2`]
	 18 : npcSettings        : static_npc_settings*
	 1C : initSource         : bytecode*
	 20 : interactSource     : bytecode*
	 24 : aiSource           : bytecode*
	 28 : hitSource          : bytecode*
	 2C : auxSource          : bytecode*
	 30 : defeatSource       : bytecode*
	 34 : initScript         : script_context*
	 38 : interactScript     : script_context*
	 3C : aiScript           : script_context*
	 40 : hitScript          : script_context*
	 44 : auxScript          : script_context*
	 48 : defeatScript       : script_context*
	 4C : initScriptID       : int
	 50 : interactScriptID   : int
	 54 : aiScriptID         : int
	 58 : hitScriptID        : int
	 5C : auxScriptID        : int
	 60 : defeatScriptID     : int
	 64 : unk_64             : ptr
	 68 : unk_68             : ubyte[4`]
	 6C : varTable           : int[16`]
	 AC : aiDetectFlags      : ubyte
	 AD : pad_AD             : ubyte[3`]
	 B0 : aiFlags            : uint
	 B4 : aiSuspendTime      : byte
	 B5 : instigatorValue    : byte       % passed to the first actor when battle starts
	 B6 : pad_B6             : ubyte[2`]
	 B8 : unk_B8             : bytecode*
	 BC : unk_BC             : script_context*
	 C0 : unk_C0             : int
	 C4 : unk_C4             : int
	 C8 : unk_C8             : int
	 CC : animList           : animID*
	 D0 : territory          : ptr
	 D4 : drops              : ptr
	 D8 : tattleMsg          : stringID
	 DC : unk_DC             : int
	 E0 : savedNpcYaw        : short
	 E2 : pad_E2             : ubyte[6`]
}

