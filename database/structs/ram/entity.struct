% entity
type: ram
size: F8
fields:
{
	  0 : flags                    : int
	  4 : listIndex                : ubyte
	  5 : unk_05                   : byte
	  6 : collisionFlags           : ubyte
	  7 : collisionTimer           : byte
	  8 : unk_08                   : ubyte
	  9 : scriptDelay              : ubyte
	  A : type                     : ubyte
	  B : alpha                    : ubyte
	  C : aabb                     : short[3`]
	 12 : vertexSegment            : short
	 14 : virtualModelIndex        : short
	 16 : shadowIndex              : short
	 18 : scriptReadPos            : ptr
	 1C : updateScriptCallback     : code
	 20 : updateMatrixOverride     : code
	 24 : boundScript              : script_context*
	 28 : boundScriptBytecode      : bytecode*
	 2C : savedReadPos             : ptr[3`]
	 38 : blueprint                : static_entity_data*
	 3C : renderSetupFunc          : code
	 40 : dataBuf                  : ptr        % entity-type-specific data
	 44 : gfxBaseAddr              : ptr
	 48 : pos                      : vec3f
	 54 : scale                    : vec3f
	 60 : rot                      : vec3f
	 6C : shadowPosY               : float
	 70 : inverseTransformMatrix   : matrix4f   % world-to-local
	 B0 : effectiveSize            : float
	 B4 : pad_B4                   : ubyte[4`]
	 B8 : transformMatrix          : matrix4s
}

