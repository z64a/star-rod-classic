
% battle loading code
@Hook:Global 80072C18 % 4E018
{
	% copy the compressed section to the temporary buffer
	LIO		A2, $Global_BattleYay0Buffer
	JAL		8002973C
	RESERVED
	% decode Yay0 from the temporary buffer to dest
	LW		A1, C (S1)
	LIO		A0, $Global_BattleYay0Buffer
	JAL		8006EDF0
	RESERVED
	% jump back
	J		80072C20
	ADDIU	V1, V1, 8
}

% LoadBattleSection
@Hook:Battle 80269E10
{
	% copy the compressed section to the temporary buffer
	LW		A2, C (V0)
	SW		A2, 14 (SP) % unused stack var
	LIO		A2, $Global_BattleYay0Buffer
	JAL		8002973C
	RESERVED
	% decode Yay0 from the temporary buffer to dest
	LW		A1, 14 (SP) % unused stack var
	LIO		A0, $Global_BattleYay0Buffer
	JAL		8006EDF0
	RESERVED
	J		80269E18
	NOP
}

